*******************************
**BEGIN City.ddck
*******************************

*******************************************************************
** Author         : Daniel Carbonell
** Creation date  : 2016
** Last changes   : 10.2024 udpates for defaultVisibility "local"
********************************************************************

********************************************************************
** Description:
** city specific weather data and reference path to Meteonorm file
********************************************************************

CONSTANTS #
Lat = 47.38     ! Latitude, °
TambD = -13.2     ! ambient design temperature of heating system, °C
TambAvg = 9.99    ! average outdoor temperature, °C
dTambAmpl = 9.3   ! amplitude of outside temperature, K
tTambShift = 488  ! Offset of outside air temperature minimum , h
ddTcwOffset = 40  ! time shift of minimum cold water temperature, d
altid = 556
formatWeatherData  = 1  ! 1 = user format, 2 = Standard weather file in the TMY2 format
unitWeatherData    = 38

ASSIGN PATH$\Weather_SPF\MeteoSwiss\SMA\SMA_hourlyMean.99 unitWeatherData

*******************************
**END City.ddck
*******************************