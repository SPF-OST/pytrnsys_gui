*******************************
** BEGIN Type67.ddck
*******************************

************************************************************************************************************************
** Description: 
** Shading Mask
************************************************************************************************************************

************************************************************************************************************************
** Details: 
** Type67 reads a file containing the angular heights of obstructions that shade a series of openings. For each opening,
** a numerical ID in ascending order is provided on the first line of the data file. The second line contains the slope
** of each opening. The third line contains the azimuth of each opening. The fourth line contains a series of absolute
** surface angles; angles for which obstruction heights will later be provided. The fifth and subsequent lines of the
** data file each contain the angular height of an arbitrary obstruction as seen from the center of an aperture while
** looking in the direction of one of the above provided surface azimuth angles. Type67 takes two inputs that give the
** angle of the sun, two inputs that give total and diffuse radiation on the horizontal and then two inputs for each
** opening that give the beam and diffuse radiation on each opening. The components returns ten outputs for each opening
** in the file. The first output is the fraction of beam radiation that is visible from the opening. The second is the
** shaded beam radiation on the opening. The third output is the fraction of diffuse radiation incident on the surface.
** The fourth and fifth outputs give the shaded diffuse and shaded total radiation respectively (both on the plane of
** the opening). Outputs six through ten (for each opening) give the same values in the plane of the horizontal.
************************************************************************************************************************



***********************************
** outputs to other ddck
***********************************


***********************************
** Dependencies with other ddck
***********************************


***********************************
** Begin CONSTANTS
***********************************
EQUATIONS #
NOpen = 1
NAng = 16

CONSTANTS 1
MaskingOn = 1    ! 1: shading mask on, 0: off, outputs = unmasked radiation (overwritten by "deck ShadingMaskingOn" in the config)

***********************************
** Begin TYPE
***********************************
CONSTANTS #
unitShadingData = 40
ASSIGN PATH$\Controllers_Library_SPF\Controllers_for_solar_collectors\database\Type67-ShadingMasks.dat unitShadingData
UNIT 1 TYPE 67
PARAMETERS 3
unitShadingData ! 1: Logical unit for data file [-] ([10,+Inf])
NOpen ! 2: Number of openings in file [-] ([1,40])
NAng ! 3: Number of surface angles [-] ([1,80])

INPUTS 6
$weatherAISA ! 1: Solar azimuth angle [degrees] ([-Inf,+Inf])
$weatherAISZ ! 2: Solar zenith angle [degrees] ([-Inf,+Inf])
$weatherIT_H ! 3: Total radiation on horizontal [kJ/hr.m^2] ([0,+Inf])
$weatherID_H ! 4: Diffuse radiation on horizontal [kJ/hr.m^2] ([0,+Inf])
$weatherIB_surfUser_1 ! 5: Beam radiation for opening [kJ/hr.m^2] ([0,+Inf])
$weatherID_surfUser_1 ! 6: Diffuse radiation for opening [kJ/hr.m^2] ([0,+Inf])

** initial values
-90.0 ! 1: Solar azimuth angle  initial value
90.0 ! 2: Solar zenith angle  initial value
0.0 ! 3: Total radiation on horizontal  initial value
0.0 ! 4: Diffuse radiation on horizontal  initial value
0.0 ! 5: Beam radiation for opening  initial value
0.0 ! 6: Diffuse radiation for opening  initial value

EQUATIONS #
AngSun =                    [1, 1] ! Solar altitude angle [degrees] ([-Inf,+Inf])
FracIBMasked_surfUser_1 =   [1, 2] ! Fraction of beam visible for surf. [-] ([-Inf,+Inf])
$IBMasked_surfUser_1 =      MaskingOn*[1, 3] + NOT(MaskingOn)*$weatherIB_surfUser_1 ! Shaded beam rad. for surf. [kJ/hr.m^2] ([-Inf,+Inf])
FracIDMasked_surfUser_1 =   [1, 4] ! Fraction of diffuse visible for surf. [-] ([-Inf,+Inf])
$IDMasked_surfUser_1 =      MaskingOn*[1, 5] + NOT(MaskingOn)*$weatherID_surfUser_1 ! Shaded diffuse rad. on surf.  [kJ/hr.m^2] ([-Inf,+Inf])
$ITMasked_surfUser_1  =     MaskingOn*[1, 6] + NOT(MaskingOn)*$weatherIT_surfUser_1 ! Shaded total rad. for surf. [kJ/hr.m^2] ([-Inf,+Inf])
FracIBMasked_H =            [1, 7] ! Fraction of beam visible on horiz. for mask [-] ([-Inf,+Inf])
$IBMasked_H =               MaskingOn*[1, 8] + NOT(MaskingOn)*$weatherIB_H ! Shaded beam rad. on horiz. for mask [kJ/hr.m^2] ([-Inf,+Inf])
FracIDMasked_H =            [1, 9] ! Fraction of diffuse visible on horiz. for mask [-] ([-Inf,+Inf])
$IDMasked_H =               MaskingOn*[1, 10] + NOT(MaskingOn)*$weatherID_H ! Shaded diffuse rad. on horiz. for mask [kJ/hr.m^2] ([-Inf,+Inf])
$ITMasked_H =               MaskingOn*[1, 11] + NOT(MaskingOn)*$weatherIT_H ! Shaded total rad. on horiz. for mask [kJ/hr.m^2] ([-Inf,+Inf])

! Sky and ground diffuse split (Type67 only gives the total diffuse): the same visible fraction is applied to both
FracIDMaskedAct_surfUser_1 = MaskingOn*FracIDMasked_surfUser_1 + NOT(MaskingOn)
$IDSMasked_surfUser_1 = FracIDMaskedAct_surfUser_1*$weatherIDS_surfUser_1 ! Shaded sky diffuse rad. on surf. [kJ/hr.m^2]
$IDGMasked_surfUser_1 = FracIDMaskedAct_surfUser_1*$weatherIDG_surfUser_1 ! Shaded ground diffuse rad. on surf. [kJ/hr.m^2]



***********************************
** Monthly printer
***********************************
CONSTANTS 1
unitPrinterMaskingMo = 53
ASSIGN temp\MASKING_MO.Prt unitPrinterMaskingMo
UNIT 52 TYPE 46
PARAMETERS 5
unitPrinterMaskingMo ! 1: Logical unit number, -
-1  ! 2: Logical unit for monthly summaries
1   ! 3: Relative or absolute start time. 0: print at time intervals relative to the simulation start time. 1: print at absolute time intervals. No effect for monthly integrations
-1  ! 4: Printing & integrating interval, h. -1 for monthly integration
0   ! 5: Number of inputs to avoid integration
INPUTS #
AngSun
FracIBMasked_surfUser_1
$IBMasked_surfUser_1
FracIDMasked_surfUser_1
$IDMasked_surfUser_1
$ITMasked_surfUser_1
FracIBMasked_H
$IBMasked_H
FracIDMasked_H
$IDMasked_H
$ITMasked_H
$weatherIB_surfUser_1
$weatherIT_surfUser_1
$weatherID_surfUser_1
***
AngSun
FracIBMasked1
$IBMasked_surfUser_1
FracIDMasked1
$IDMasked_surfUser_1
$ITMasked_surfUser_1
FracIBMasked_H
$IBMasked_H
FracIDMasked_H
$IDMasked_H
$ITMasked_H
$weatherIB_surfUser_1
$weatherIT_surfUser_1
$weatherID_surfUser_1


